{
  "expo": {
    "name": "Ferson",
    "slug": "ferson",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ferson",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ferson.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ferson uses your microphone only when you record a voice message."
      }
    },
    "android": {
      "package": "com.ferson.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F4EEE6"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Ferson to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07ee8c4f-abbf-4c02-8e5c-147868669d1e"
      }
    },
    "owner": "pearlapps"
  }
}
